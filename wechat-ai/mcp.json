{
  "skillId": "time-tracker-wechat",
  "skillName": "时间统计助手",
  "version": "2.0.0",
  "description": "用自然语言记录时间花销，自动归类，卡片式展示统计",
  "apis": [
    {
      "name": "recordTime",
      "description": "记录一条时间花销。用户用自然语言描述活动+时长时调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "string",
            "description": "活动名称，如「看书」「健身」「写代码」"
          },
          "duration_min": {
            "type": "number",
            "description": "时长，单位：分钟",
            "minimum": 1,
            "maximum": 1440
          },
          "date": {
            "type": "string",
            "description": "日期，格式 YYYY-MM-DD。不传则默认当天",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": ["activity", "duration_min"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否成功"
          },
          "recordId": {
            "type": "string",
            "description": "新创建的记录 ID，格式 YYYYMMDD-HHmmss-xxxx"
          },
          "activity": {
            "type": "string",
            "description": "标准化后的活动名称"
          },
          "duration_min": {
            "type": "number",
            "description": "时长（分钟）"
          },
          "category": {
            "type": "string",
            "description": "所属类别"
          },
          "date": {
            "type": "string",
            "description": "记录日期"
          },
          "today_total": {
            "type": "number",
            "description": "当日总记录分钟数"
          },
          "today_count": {
            "type": "number",
            "description": "当日记录条数"
          }
        },
        "required": ["success", "recordId", "activity", "duration_min", "category", "date"],
        "additionalProperties": false
      },
      "_meta": {
        "ui": {
          "componentPath": "components/stat-card/index"
        }
      }
    },
    {
      "name": "getStats",
      "description": "查询指定时间范围的统计摘要。用户问「看统计」「本周统计」等时调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "description": "统计时间范围",
            "enum": ["week", "month", "year"]
          }
        },
        "required": ["range"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "description": "统计范围标识"
          },
          "label": {
            "type": "string",
            "description": "范围文字标签，如「本周（6.8 - 6.14）」"
          },
          "total_min": {
            "type": "number",
            "description": "总投入分钟数"
          },
          "daily_avg_min": {
            "type": "number",
            "description": "日均投入分钟数"
          },
          "record_count": {
            "type": "number",
            "description": "记录总条数"
          },
          "streak_days": {
            "type": "number",
            "description": "连续记录天数"
          },
          "category_breakdown": {
            "type": "array",
            "description": "按类别汇总",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string" },
                "total_min": { "type": "number" },
                "percentage": { "type": "number" },
                "color": { "type": "string" }
              },
              "required": ["category", "total_min", "percentage"]
            }
          },
          "top_activities": {
            "type": "array",
            "description": "排名前 5 的活动",
            "items": {
              "type": "object",
              "properties": {
                "activity": { "type": "string" },
                "total_min": { "type": "number" },
                "percentage": { "type": "number" }
              },
              "required": ["activity", "total_min", "percentage"]
            }
          },
          "insights": {
            "type": "array",
            "description": "数据洞察（1-3 条）",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["streak", "trend", "dominant", "warning"]
                },
                "text": { "type": "string" }
              },
              "required": ["type", "text"]
            }
          }
        },
        "required": ["range", "label", "total_min", "category_breakdown"],
        "additionalProperties": false
      },
      "_meta": {
        "ui": {
          "componentPath": "components/stat-card/index"
        }
      }
    },
    {
      "name": "modifyRecord",
      "description": "修改或删除一条时间记录。用户说「改一下」「删掉」等时调用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "记录 ID"
          },
          "action": {
            "type": "string",
            "description": "操作类型",
            "enum": ["modify", "delete"]
          },
          "duration_min": {
            "type": "number",
            "description": "新的时长（action=modify 时必填），单位：分钟",
            "minimum": 1,
            "maximum": 1440
          },
          "activity": {
            "type": "string",
            "description": "新的活动名（action=modify 时可选）"
          },
          "category": {
            "type": "string",
            "description": "新的类别名（action=modify 时可选）"
          }
        },
        "required": ["id", "action"],
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "modify" } }
            },
            "then": {
              "anyOf": [
                { "required": ["duration_min"] },
                { "required": ["activity"] },
                { "required": ["category"] }
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否成功"
          },
          "action": {
            "type": "string",
            "description": "执行的操作"
          },
          "record": {
            "type": "object",
            "description": "被操作的记录（删除时返回原记录信息）",
            "properties": {
              "id": { "type": "string" },
              "activity": { "type": "string" },
              "duration_min": { "type": "number" },
              "category": { "type": "string" },
              "date": { "type": "string" }
            }
          }
        },
        "required": ["success", "action"],
        "additionalProperties": false
      },
      "_meta": {
        "ui": {
          "componentPath": "components/stat-card/index"
        }
      }
    }
  ],
  "components": [
    {
      "name": "stat-card",
      "description": "统计卡片组件。展示时间统计摘要，含环形图、关键指标、类别占比。用于 getStats API 的返回结果渲染。",
      "componentPath": "components/stat-card/index",
      "props": {
        "total_min": { "type": "number", "description": "总投入分钟数" },
        "daily_avg_min": { "type": "number", "description": "日均投入分钟数" },
        "streak_days": { "type": "number", "description": "连续记录天数" },
        "label": { "type": "string", "description": "范围标签" },
        "category_breakdown": { "type": "array", "description": "类别分布" },
        "top_activities": { "type": "array", "description": "活动排名" },
        "insights": { "type": "array", "description": "数据洞察" }
      }
    },
    {
      "name": "day-detail",
      "description": "日详情卡片组件。展示某一天的详细时间分配，含饼状图、活动列表。",
      "componentPath": "components/day-detail/index",
      "props": {
        "date": { "type": "string", "description": "日期" },
        "total_min": { "type": "number", "description": "当日总分钟数" },
        "activities": {
          "type": "array",
          "description": "当日活动列表",
          "items": {
            "type": "object",
            "properties": {
              "activity": { "type": "string" },
              "category": { "type": "string" },
              "duration_min": { "type": "number" },
              "percentage": { "type": "number" },
              "color": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
